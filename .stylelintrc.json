{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-recess-order"
  ],
  "rules": {
    "color-hex-case": "lower",
    "color-hex-length": "short",
    "unit-case": "lower",
    "selector-class-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
    "selector-id-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "custom-property-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "font-family-name-quotes": "always-where-recommended",
    "font-weight-notation": "numeric",
    "number-leading-zero": "always",
    "length-zero-no-unit": true,
    "color-function-notation": "modern",
    "media-feature-range-notation": "context",
    "declaration-block-no-redundant-longhand-properties": true,
    "declaration-block-no-shorthand-property-overrides": true,
    "shorthand-property-no-redundant-values": true,
    "no-descending-specificity": true,
    "no-duplicate-selectors": true,
    "no-empty-source": true,
    "no-unknown-animations": true,
    "keyframe-animation-name-no-unused": true,
    "animation-iteration-count-no-another": true,
    "declaration-block-no-redundant-longhand-properties": true,
    "comment-empty-line-before": ["always", {
      "except": ["first-nested"]
    }],
    "declaration-empty-line-before": "never",
    "rule-empty-line-before": ["always-multi-line", {
      "except": ["first-nested"]
    }],
    "block-closing-brace-newline-before": "always-multi-line",
    "selector-max-id": 0,
    "selector-max-universal": 0,
    "selector-max-empty-lines": 1,
    "declaration-block-no-duplicate-properties": true,
    "declaration-block-no-redundant-longhand-properties": true,
    "declaration-block-semicolon-newline-after": "always-multi-line",
    "declaration-colon-space-after": "always-single-line",
    "declaration-colon-space-before": "never",
    "declaration-block-no-duplicate-properties": true,
    "selector-list-comma-newline-after": "always-multi-line",
    "selector-list-comma-space-after": "always-single-line",
    "value-list-comma-newline-after": "always-multi-line",
    "value-list-comma-space-after": "always-single-line",
    "value-list-max-empty-lines": 0,
    "function-parentheses-space-inside": "never",
    "function-comma-space-after": "always-single-line",
    "function-url-quotes": "always",
    "at-rule-name-case": "lower",
    "at-rule-name-space-after": "always",
    "at-rule-empty-line-before": ["always", {
      "except": ["first-nested"]
    }],
    "at-rule-no-vendor-prefix": true,
    "at-rule-no-unsupported": true,
    "block-no-empty": true,
    "block-no-unsupported": true,
    "color-no-hex": false,
    "declaration-block-no-shorthand": false,
    "declaration-no-important": true,
    "declaration-block-no-important": true,
    "selector-max-attribute": 5,
    "selector-max-class": 5,
    "selector-max-combinators": 3,
    "selector-max-compound-selectors": 4,
    "selector-max-specificity": "0,4,0",
    "selector-max-universal": 0,
    "selector-max-id": 0,
    "time-min-milliseconds": 100,
    "unit-allowed-list": ["px", "rem", "em", "%", "vh", "vw", "ch", "cm", "mm", "in", "pt", "pc", "deg", "rad", "turn", "s", "ms", "Hz", "kHz", "dpi", "dpcm", "dppx", "fr", "cap", "ic", "lh", "rlh", "vi", "vb", "vmin", "vmax", "cqw", "cqh", "cqi", "cqb", "cqmin", "cqmax"],
    "color-hex-alpha": true,
    "alpha-value-notation": "number",
    "hue-degree-notation": "angle",
    "percentage-notation": "number",
    "number-no-trailing-zero": true,
    "length-zero-no-unit": true,
    "number-leading-zero": "always",
    "unit-case": "lower",
    "declaration-property-value-disallowed-list": {
      "background-image": ["/url\\(/i"],
      "font-size": ["0.96px"]
    }
  },
  "ignoreFiles": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "*.min.css",
    "*.map",
    ".git/**",
    "coverage/**"
  ]
}
