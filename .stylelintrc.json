{
  "extends": [
    "stylelint-config-standard",
    "stylelint-config-recess-order"
  ],
  "rules": {
    "color-hex-length": "short",
    "selector-class-pattern": "^[a-z][a-zA-Z0-9]*(?:[-_][a-zA-Z0-9]+)*(?:__[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*)?(?:--[a-zA-Z0-9]+(?:[-_][a-zA-Z0-9]+)*)?$",
    "selector-id-pattern": "^[a-z][a-zA-Z0-9]*(?:[-_][a-zA-Z0-9]+)*$",
    "custom-property-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "keyframes-name-pattern": "^[a-z][a-zA-Z0-9-]*$",
    "font-family-name-quotes": "always-where-recommended",
    "font-weight-notation": "numeric",
    "length-zero-no-unit": true,
    "color-function-notation": "modern",
    "media-feature-range-notation": "context",
    "declaration-block-no-redundant-longhand-properties": true,
    "declaration-block-no-shorthand-property-overrides": true,
    "shorthand-property-no-redundant-values": true,
    "no-empty-source": true,
    "no-descending-specificity": null,
    "no-duplicate-selectors": null,
    "no-unknown-animations": null,
    "declaration-block-single-line-max-declarations": null,
    "comment-empty-line-before": ["always", {
      "except": ["first-nested"]
    }],
    "declaration-empty-line-before": "never",
    "rule-empty-line-before": ["always-multi-line", {
      "except": ["first-nested"]
    }],
    "selector-max-id": 1,
    "selector-max-universal": 1,
    "declaration-block-no-duplicate-properties": true,
    "function-url-quotes": "always",
    "at-rule-empty-line-before": ["always", {
      "except": ["first-nested"]
    }],
    "at-rule-no-vendor-prefix": true,
    "block-no-empty": true,
    "color-no-hex": null,
    "selector-max-attribute": 5,
    "selector-max-class": 5,
    "selector-max-combinators": 3,
    "selector-max-compound-selectors": 4,
    "selector-max-specificity": "1,5,0",
    "media-feature-name-no-unknown": [true, {
      "ignoreMediaFeatureNames": ["min-device-pixel-ratio", "-webkit-min-device-pixel-ratio", "-moz-min-device-pixel-ratio"]
    }],
    "unit-allowed-list": ["px", "rem", "em", "%", "vh", "vw", "ch", "cm", "mm", "in", "pt", "pc", "deg", "rad", "turn", "s", "ms", "Hz", "kHz", "dpi", "dpcm", "dppx", "fr", "cap", "ic", "lh", "rlh", "vi", "vb", "vmin", "vmax", "cqw", "cqh", "cqi", "cqb", "cqmin", "cqmax"],
    "color-hex-alpha": null,
    "alpha-value-notation": "number",
    "hue-degree-notation": "angle",
    "declaration-property-value-disallowed-list": {
      "font-size": ["0.96px"]
    }
  },
  "ignoreFiles": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "*.min.css",
    "*.map",
    ".git/**",
    "coverage/**"
  ]
}
