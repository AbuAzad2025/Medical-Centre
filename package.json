{
  "name": "medical-system-frontend",
  "version": "1.0.0",
  "description": "Frontend tooling for Medical Centre Management System",
  "private": true,
  "scripts": {
    "lint:css": "stylelint \"static/css/**/*.css\"",
    "lint:css:fix": "stylelint \"static/css/**/*.css\" --fix",
    "spellcheck": "cspell \"**/*.{py,html,js,css,md,json,toml,yaml,yml,sql,ini,cfg,conf,sh,bat,ps1}\"",
    "spellcheck:fix": "cspell \"**/*.{py,html,js,css,md,json,toml,yaml,yml,sql,ini,cfg,conf,sh,bat,ps1}\" --fix"
  },
  "devDependencies": {
    "stylelint": "16.26.1",
    "stylelint-config-standard": "36.0.1",
    "stylelint-config-recess-order": "5.1.1",
    "cspell": "8.19.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}